# Public address used by members. WEB_ORIGIN must include the scheme.
APP_DOMAIN=community.example.com
WEB_ORIGIN=https://community.example.com
HTTP_PORT=80
HTTPS_PORT=443

# Required production secrets. Generate independent values for each entry.
POSTGRES_PASSWORD=<strong-url-safe-database-password>
JWT_SECRET=<generate-a-strong-random-secret>
PASSWORD_PEPPER=<generate-a-strong-random-secret>
PASSWORD_PEPPER_PREVIOUS=
EMAIL_ENCRYPTION_KEY=<generate-a-strong-independent-secret>
REGISTRATION_KEY_HASH_SECRET=<generate-a-strong-independent-secret>

# Required in production before first-run setup. Generate a strong random value,
# keep it secret, and clear or rotate it after setup completes.
SETUP_TOKEN=
OWNER_BREAK_GLASS_SECRET=

# Same-origin defaults used by the canonical Compose deployment.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_REALTIME_ORIGIN=
API_PUBLIC_URL=
INTERNAL_API_URL=http://api:4000
SESSION_COOKIE_SECURE=
SESSION_COOKIE_NAME=pe_session

# WebAuthn values must match the public browser origin exactly.
WEBAUTHN_RP_NAME=PE Community
WEBAUTHN_RP_ID=community.example.com
WEBAUTHN_ORIGIN=https://community.example.com

# Trusted proxy and optional edge-provided country context.
TRUSTED_PROXY_CIDRS=loopback,linklocal,uniquelocal
SECURITY_COUNTRY_HEADER=
SECURITY_COUNTRY_TRUSTED_PROXY_CIDRS=

# Retention periods in whole days (30-3650).
SECURITY_EVENT_RETENTION_DAYS=180
SESSION_SECURITY_METADATA_RETENTION_DAYS=180

# Optional SMTP fallback. SMTP can also be configured in administration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Release tag used by the API, Web, and Worker images.
PE_COMMUNITY_VERSION=<release-tag>

# Optional host updater integration. Configure only after completing deploy/updater/README.md.
# Generate this independently and place the same value in /etc/pe-community-updater/updater.env.
PE_UPDATER_SHARED_SECRET=
PE_UPDATER_SOCKET=/run/pe-community-updater/updater.sock
PE_UPDATER_RUNTIME_DIR=/run/pe-community-updater
